# Copy to .env (gitignored) for local development. None of these are
# required to run `npm start` -- every one degrades gracefully when unset.
# Bloxity Legion hosting injects most of them in deployed environments.

# MongoDB connection string for player-progress persistence (per game+channel).
# Unset locally = no persistence (progress lasts the connection only).
MONGODB_URI=

# CORS allow-origin for deployed environments. Falls back to "*" when unset.
CLIENT_ORIGIN=

# HTTP port. Falls back to 2567 when unset.
PORT=2567

# Secret Colyseus uses for signed auth tokens (injected by Legion).
JWT_SECRET=

# Bloxity platform URLs. Only the API URL is called by the server; the rest are injected for
# reference. API defaults to https://api.bloxity.io (token + ad-reward verification, leaderboards).
BLOXITY_API_URL=
BLOXITY_MATCHMAKER_URL=
BLOXITY_PORTAL_URL=
BLOXITY_STATIC_URL=

# Game slug on Bloxity (verify calls + hosted leaderboards). Falls back to the placeholder in constants.ts.
BLOXITY_GAME_ID=
# Bearer token for the hosted-leaderboard report endpoint. Reporting is a no-op while this or
# BLOXITY_GAME_ID is unset.
BLOXITY_REPORT_TOKEN=
# Deploy channel (prod | dev) and pod name, injected by Legion (logging only).
BLOXITY_CHANNEL=
POD_NAME=
